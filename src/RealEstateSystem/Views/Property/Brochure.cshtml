@model RealEstateSystem.Models.Property
@using RealEstateSystem.Helpers
@{
    Layout = null;
    var p = Model;
    var images = (p.Images ?? new List<PropertyImage>()).OrderByDescending(i => i.IsPrimary).ThenBy(i => i.SortOrder).Take(4).ToList();
    string pageUrl = Request.Url.GetLeftPart(UriPartial.Authority) + Url.Action("Details", "Property", new { id = p.Id });
    string desc = p.Description ?? "";
    if (desc.Length > 650) { desc = desc.Substring(0, 650).TrimEnd() + "..."; }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brochure - @p.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #e9edf2; font-family: Arial, "Segoe UI", sans-serif; }
        .toolbar { max-width: 794px; margin: 16px auto; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        #brochure { width: 794px; margin: 0 auto 32px; background: #fff; padding: 30px 36px; color: #1f2937; }
        .b-head { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #C9A24B; padding-bottom: 12px; margin-bottom: 18px; }
        .b-brand { font-size: 22px; font-weight: 700; color: #1E3A5F; letter-spacing: 1px; }
        .b-badge { display: inline-block; background: #1E3A5F; color: #fff; padding: 3px 10px; border-radius: 6px; font-size: 12px; margin-right: 6px; }
        .b-title { font-size: 24px; font-weight: 700; color: #1E3A5F; margin: 10px 0 4px; }
        .b-price { font-size: 26px; font-weight: 700; color: #B8860B; margin-bottom: 14px; }
        .b-hero { width: 100%; height: 300px; object-fit: cover; border-radius: 8px; }
        .b-thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 8px; }
        .b-thumbs img { width: 100%; height: 100px; object-fit: cover; border-radius: 6px; }
        .b-specs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 16px 0; }
        .b-spec { background: #f3f6fa; border-radius: 8px; padding: 10px; text-align: center; }
        .b-spec b { display: block; font-size: 16px; color: #1E3A5F; }
        .b-spec span { font-size: 12px; color: #6b7280; }
        .b-sec { font-size: 15px; font-weight: 700; color: #1E3A5F; margin: 14px 0 6px; border-left: 4px solid #C9A24B; padding-left: 8px; }
        .b-tbl td { padding: 4px 8px; font-size: 13px; border-bottom: 1px solid #eef1f5; }
        .b-tbl td:first-child { color: #6b7280; width: 140px; }
        .b-desc { font-size: 13px; line-height: 1.55; white-space: pre-wrap; }
        .b-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 16px; padding-top: 14px; border-top: 1px dashed #cbd5e1; }

    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" id="btnPdf" class="btn btn-primary"><i class="bi bi-file-earmark-pdf"></i> Tải PDF</button>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> In</button>
        <a class="btn btn-outline-secondary" href="@Url.Action("Details", "Property", new { id = p.Id })"><i class="bi bi-arrow-left"></i> Quay lại tin</a>
        <span id="pdfStatus" class="small text-muted"></span>
    </div>

    <div id="brochure">
        <div class="b-head">
            <div class="b-brand">ESTORA</div>
            <div class="small text-muted">Real Estate System</div>
        </div>

        <div>
            @if (p.TransactionType != null) { <span class="b-badge">@p.TransactionType.Label()</span> }
            @if (p.PropertyType != null) { <span class="b-badge" style="background:#6b7280">@p.PropertyType.Name</span> }
        </div>
        <div class="b-title">@p.Title</div>
        <div class="small text-muted mb-2"><i class="bi bi-geo-alt-fill"></i> @p.District, @p.City</div>
        <div class="b-price">@p.PriceText()</div>

        @if (images.Count > 0)
        {
            <img class="b-hero" src="@Url.ImageSrc(images[0])" alt="@p.Title" />
            if (images.Count > 1)
            {
                <div class="b-thumbs">
                    @for (int i = 1; i < images.Count; i++) { <img src="@Url.ImageSrc(images[i])" alt="Ảnh @(i + 1)" /> }
                </div>
            }
        }

        <div class="b-specs">
            <div class="b-spec"><b>@p.Area.ToString("0.##") m²</b><span>Diện tích</span></div>
            <div class="b-spec"><b>@(p.Bedrooms.HasValue ? p.Bedrooms.Value.ToString() : "—")</b><span>Phòng ngủ</span></div>
            <div class="b-spec"><b>@(p.Bathrooms.HasValue ? p.Bathrooms.Value.ToString() : "—")</b><span>Phòng tắm</span></div>
            <div class="b-spec"><b>@(p.Floors.HasValue ? p.Floors.Value.ToString() : "—")</b><span>Số tầng</span></div>
        </div>

        <table class="b-tbl w-100">
            <tr><td>Pháp lý</td><td>@(p.LegalStatus != null ? p.LegalStatus.Name : "—")</td></tr>
            <tr><td>Nội thất</td><td>@(p.FurnitureStatus != null ? p.FurnitureStatus.Name : "—")</td></tr>
            <tr><td>Trạng thái</td><td>@p.Status.StatusText()</td></tr>
            @if (!string.IsNullOrWhiteSpace(p.Amenities)) { <tr><td>Tiện ích</td><td>@p.Amenities</td></tr> }
        </table>

        @if (!string.IsNullOrWhiteSpace(desc))
        {
            <div class="b-sec">Mô tả</div>
            <div class="b-desc">@desc</div>
        }

        <div class="b-foot">
            <div>
                <div class="b-sec" style="margin-top:0">Liên hệ môi giới</div>
                @if (p.Agent != null)
                {
                    <div style="font-size:14px"><b>@p.Agent.FullName</b></div>
                    <div style="font-size:13px"><i class="bi bi-telephone"></i> @p.Agent.Phone</div>
                    <div style="font-size:13px"><i class="bi bi-envelope"></i> @p.Agent.Email</div>
                }
                <div class="small text-muted mt-2" style="word-break:break-all;max-width:480px">@pageUrl</div>
            </div>
            
        </div>
    </div>

    
    <script src="https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js"></script>
    <script>
(function () {
    var url = @Html.Raw(Json.Encode(pageUrl));
    

    var status = document.getElementById('pdfStatus');
    function makePdf() {
        if (typeof html2pdf === 'undefined') { status.textContent = 'Không tải được thư viện PDF. Hãy kiểm tra kết nối mạng hoặc dùng nút In và chọn "Lưu dưới dạng PDF".'; return; }
        status.textContent = 'Đang tạo PDF...';
        html2pdf().set({
            margin: 0,
            filename: 'brochure-tin-@(p.Id).pdf',
            image: { type: 'jpeg', quality: 0.95 },
            html2canvas: { scale: 2, useCORS: true },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
            pagebreak: { mode: ['avoid-all', 'css'] }
        }).from(document.getElementById('brochure')).save().then(function () {
            status.textContent = 'Đã tạo xong file PDF.';
        });
    }
    document.getElementById('btnPdf').addEventListener('click', makePdf);

    // Mo tu nut "Tai brochure PDF" tren trang tin -> tu dong tai ngay khi anh da tai xong
    if (location.search.indexOf('download=1') >= 0) {
        window.addEventListener('load', function () { setTimeout(makePdf, 500); });
    }
})();
    </script>
</body>
</html>
