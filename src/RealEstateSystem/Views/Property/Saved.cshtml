@model List<RealEstateSystem.Models.Property>
@{
    ViewBag.Title = "Tin đã lưu";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h3 class="mb-0">Tin đã lưu</h3>
            <small class="text-muted">Danh sách tin yêu thích của tài khoản bạn, xem được trên mọi thiết bị</small>
        </div>
        <a class="btn btn-outline-brand" href="@Url.Action("Index", "Property")"><i class="bi bi-search"></i> Tiếp tục xem tin</a>
    </div>

    <div id="emptyBox" class="card border-0 shadow-sm @(Model.Count > 0 ? "d-none" : "")">
        <div class="card-body text-center py-5">
            <div class="display-4 text-muted"><i class="bi bi-heart"></i></div>
            <h5 class="mt-3">Bạn chưa lưu tin nào</h5>
            <p class="text-muted mb-0">Bấm biểu tượng trái tim trên mỗi tin để lưu lại và xem sau.</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-6 col-lg-4 saved-col">
                @Html.Partial("_PropertyCard", p)
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        // Bo luu mot tin -> go the do khoi trang
        document.addEventListener('estora:saved', function (e) {
            if (e.detail.saved) return;
            var btn = document.querySelector('[data-save-id="' + e.detail.id + '"]');
            var col = btn ? btn.closest('.saved-col') : null;
            if (col) col.remove();
            if (!document.querySelector('.saved-col'))
                document.getElementById('emptyBox').classList.remove('d-none');
        });
    </script>
}
