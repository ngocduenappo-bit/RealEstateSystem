@model RealEstateSystem.Models.ViewModels.AdminPropertyListViewModel
@using RealEstateSystem.Helpers
@{
    ViewBag.Title = "Quản lý tin đăng";
    string current = Model.Status ?? "";
    var tabs = new[]
    {
        new { Key = "", Text = "Tất cả" },
        new { Key = "Pending", Text = "Chờ duyệt" },
        new { Key = "Active", Text = "Đang hiển thị" },
        new { Key = "Sold_Rented", Text = "Đã bán/cho thuê" }
    };
}

@Html.Partial("_AdminStyles")

<div class="ad-page">
    <div class="ad-hero">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="ad-hero-ico"><i class="bi bi-buildings"></i></span>
                    <div>
                        <h3>Quản lý tin đăng</h3>
                        <p>Duyệt, gỡ, đẩy nổi bật hoặc xóa tin của tất cả người đăng</p>
                    </div>
                </div>
                <a class="btn btn-back" href="@Url.Action("Index", "Admin")"><i class="bi bi-arrow-left"></i> Trang quản trị</a>
            </div>
        </div>
    </div>

    <div class="container ad-body">

        @* ===== Lọc ===== *@
        <div class="ad-card">
            <div class="ad-card-body py-3">
                <ul class="nav nav-pills mb-3 gap-1">
                    @foreach (var t in tabs)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(current == t.Key ? "active" : "")" style="@(current == t.Key ? "background:var(--navy)" : "")"
                               href="@Url.Action("Properties", "Admin", new { status = t.Key, keyword = Model.Keyword })">@t.Text</a>
                        </li>
                    }
                </ul>
                @using (Html.BeginForm("Properties", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
                {
                    <input type="hidden" name="status" value="@current" />
                    <div class="col-md">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" name="keyword" maxlength="100" value="@Model.Keyword" class="form-control" placeholder="Tìm theo tiêu đề hoặc tên người đăng..." />
                        </div>
                    </div>
                    <div class="col-md-auto d-flex gap-2">
                        <button type="submit" class="btn btn-brand"><i class="bi bi-search"></i> Tìm kiếm</button>
                        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                        {
                            <a class="btn btn-outline-secondary" href="@Url.Action("Properties", "Admin", new { status = current })">Xóa lọc</a>
                        }
                    </div>
                }
            </div>
        </div>

        @* ===== Danh sách ===== *@
        <div class="ad-card">
            <div class="ad-card-head">
                <span class="ad-ico"><i class="bi bi-list-ul"></i></span>
                <div><h6>Danh sách tin đăng</h6><small>Tổng cộng @Model.Paging.TotalItems tin</small></div>
            </div>

            @if (Model.Results.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="display-5 text-muted"><i class="bi bi-inbox"></i></div>
                    <p class="text-muted mt-2 mb-0">Không có tin nào phù hợp.</p>
                </div>
            }
            else
            {
                <div style="overflow-x:visible">
                    <style>
                        .ad-table-fit {
                            width: 100%
                        }

                            .ad-table-fit th, .ad-table-fit td {
                                padding: .5rem .4rem;
                                font-size: .85rem
                            }

                                .ad-table-fit td:last-child .btn {
                                    padding: .25rem .45rem
                                }
                    </style>
                    <table class="table ad-table ad-table-fit align-middle">
                        <thead>
                            <tr>
                                <th>Tin đăng</th>
                                <th>Người đăng</th>
                                <th>Giá</th>
                                <th class="text-center">Lượt xem</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Results)
                            {
                                <tr>
                                    <td style="min-width:170px">
                                        <a class="fw-semibold text-decoration-none" target="_blank" href="@Url.Action("Details", "Property", new { id = p.PropertyId })">@p.Title</a>
                                        <div class="small text-muted">
                                            @if (p.TransactionType != null)
                                            {
                                                <span class="badge badge-brand">@p.TransactionType.Label()</span>
                                            }
                                            @(p.PropertyType != null ? p.PropertyType.Name : "") &middot;
                                            @(p.District != null ? p.District.Name : "")@(string.IsNullOrEmpty(p.City) ? "" : ", " + p.City)
                                        </div>
                                        <div class="small text-muted">@p.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td>@(p.Owner != null ? p.Owner.FullName : "")</td>
                                    <td>@p.PriceText()</td>
                                    <td class="text-center">@p.ViewCount</td>
                                    <td>
                                        <span class="badge @p.Status.StatusBadge()">@p.Status.StatusText()</span>
                                        @if (p.IsFeatured)
                                        {
                                            <div class="small mt-1" style="color:var(--gold-dark)">
                                                <i class="bi bi-star-fill"></i> Nổi bật đến @p.FeaturedUntil.Value.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <div class="d-flex gap-1 align-items-center flex-nowrap justify-content-end">

                                            @if (p.Status != "Active")
                                            {
                                                using (Html.BeginForm("Approve", "Admin", new { id = p.PropertyId, returnUrl = Request.RawUrl }, FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Duyệt / hiển thị tin"><i class="bi bi-check-lg"></i></button>
                                                }
                                            }
                                            else
                                            {
                                                using (Html.BeginForm("Unpublish", "Admin", new { id = p.PropertyId, returnUrl = Request.RawUrl }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Gỡ tin này khỏi trang công khai?');" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Gỡ khỏi trang công khai"><i class="bi bi-eye-slash"></i></button>
                                                }
                                            }

                                            @* Đẩy nổi bật: chọn số ngày, chọn 0 để hủy *@
                                            @using (Html.BeginForm("Feature", "Admin", new { id = p.PropertyId, returnUrl = Request.RawUrl }, FormMethod.Post, new { @class = "d-inline-flex gap-1" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <select name="days" class="form-select form-select-sm" style="width:86px;padding-left:.4rem;padding-right:1.5rem;background-position:right .35rem center" title="Đẩy nổi bật">
                                                    <option value="7">7 ngày</option>
                                                    <option value="15">15 ngày</option>
                                                    <option value="30">30 ngày</option>
                                                    <option value="90">90 ngày</option>
                                                    <option value="0">Hủy nổi bật</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-brand" title="Áp dụng"><i class="bi bi-star"></i></button>
                                            }

                                            @using (Html.BeginForm("Delete", "Admin", new { id = p.PropertyId, returnUrl = Request.RawUrl }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Xóa vĩnh viễn tin này cùng toàn bộ ảnh?');" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa tin"><i class="bi bi-trash"></i></button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.Paging.TotalPages > 1)
                {
                    <div class="ad-card-foot">
                        @Html.Partial("_Pagination", Model.Paging)
                    </div>
                }
            }
        </div>
    </div>
</div>
