@model RealEstateSystem.Models.ViewModels.AdminInquiryListViewModel
@using RealEstateSystem.Helpers
@{
    ViewBag.Title = "Yêu cầu của khách";
    string current = Model.Status ?? "";
    var tabs = new[]
    {
        new { Key = "", Text = "Tất cả", Count = Model.NewCount + Model.RepliedCount },
        new { Key = "New", Text = "Mới", Count = Model.NewCount },
        new { Key = "Replied", Text = "Đã phản hồi", Count = Model.RepliedCount }
    };
}

@Html.Partial("_AdminStyles")

<div class="ad-page">
    <div class="ad-hero">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="ad-hero-ico"><i class="bi bi-inbox"></i></span>
                    <div>
                        <h3>Yêu cầu của khách</h3>
                        <p>Theo dõi, trả lời và cập nhật trạng thái mọi yêu cầu gửi tới các môi giới</p>
                    </div>
                </div>
                <a class="btn btn-back" href="@Url.Action("Index", "Admin")"><i class="bi bi-arrow-left"></i> Trang quản trị</a>
            </div>
        </div>
    </div>

    <div class="container ad-body">

        @* ===== Lọc ===== *@
        <div class="ad-card">
            <div class="ad-card-body py-3">
                <ul class="nav nav-pills mb-3 gap-1">
                    @foreach (var t in tabs)
                    {
                        bool active = current == t.Key;
                        <li class="nav-item">
                            <a class="nav-link @(active ? "active" : "")" style="@(active ? "background:var(--navy)" : "")"
                               href="@Url.Action("Inquiries", "Admin", new { status = t.Key, agentId = Model.AgentId, keyword = Model.Keyword })">
                                @t.Text <span class="badge bg-light text-dark ms-1">@t.Count</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Zalo", "Admin")">
                            <i class="bi bi-chat-dots"></i> Zalo <span class="badge bg-light text-dark ms-1">@Model.ZaloCount</span>
                        </a>
                    </li>
                </ul>

                @using (Html.BeginForm("Inquiries", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
                {
                    <input type="hidden" name="status" value="@current" />
                    <div class="col-md">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" name="keyword" maxlength="100" value="@Model.Keyword" class="form-control" placeholder="Tìm theo tên khách, môi giới hoặc tiêu đề tin..." />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="agentId" class="form-select" onchange="this.form.submit()">
                            <option value="">Tất cả môi giới</option>
                            @foreach (var a in Model.AgentList)
                            {
                                <option value="@a.Value" selected="@(Model.AgentId.HasValue && Model.AgentId.Value.ToString() == a.Value)">@a.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-auto d-flex gap-2">
                        <button type="submit" class="btn btn-brand"><i class="bi bi-search"></i> Tìm kiếm</button>
                        @if (!string.IsNullOrWhiteSpace(Model.Keyword) || Model.AgentId.HasValue)
                        {
                            <a class="btn btn-outline-secondary" href="@Url.Action("Inquiries", "Admin", new { status = current })">Xóa lọc</a>
                        }
                    </div>
                }
            </div>
        </div>

        @* ===== Danh sách ===== *@
        <div class="ad-card">
            <div class="ad-card-head">
                <span class="ad-ico"><i class="bi bi-list-ul"></i></span>
                <div><h6>Danh sách yêu cầu</h6><small>Tổng cộng @Model.Paging.TotalItems cuộc trò chuyện</small></div>
            </div>

            @if (Model.Rows.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="display-5 text-muted"><i class="bi bi-inbox"></i></div>
                    <p class="text-muted mt-2 mb-0">Không có yêu cầu nào phù hợp.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table ad-table align-middle">
                        <thead>
                            <tr>
                                <th>Tin đăng / Nội dung</th>
                                <th>Khách</th>
                                <th>Môi giới</th>
                                <th>Cập nhật</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Rows)
                            {
                                bool isNew = r.Status == "New";
                                <tr>
                                    <td style="min-width:280px">
                                        <a class="fw-semibold text-decoration-none" href="@Url.Action("InquiryDetails", "Admin", new { id = r.ConversationId })">@r.PropertyTitle</a>
                                        <div class="small text-muted text-truncate" style="max-width:380px">@r.LastMessage</div>
                                        <div class="small text-muted"><i class="bi bi-chat"></i> @r.MessageCount tin nhắn</div>
                                    </td>
                                    <td>@r.CustomerName</td>
                                    <td>@r.AgentName</td>
                                    <td class="text-nowrap small text-muted">@r.LastMessageAt.TimeAgo()</td>
                                    <td>
                                        <span class="badge @ViewHelper.ConversationStatusBadge(r.Status)">@ViewHelper.ConversationStatusText(r.Status)</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a class="btn btn-sm btn-outline-brand" title="Xem và trả lời" href="@Url.Action("InquiryDetails", "Admin", new { id = r.ConversationId })"><i class="bi bi-chat-text"></i></a>
                                            @using (Html.BeginForm("SetInquiryStatus", "Admin", new { id = r.ConversationId, status = isNew ? "Replied" : "New", returnUrl = Request.RawUrl }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(isNew ? "btn-outline-success" : "btn-outline-secondary")"
                                                        title="@(isNew ? "Đánh dấu đã phản hồi" : "Đánh dấu là mới")">
                                                    <i class="bi @(isNew ? "bi-check2-circle" : "bi-arrow-counterclockwise")"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.Paging.TotalPages > 1)
                {
                    <div class="ad-card-foot">
                        @Html.Partial("_Pagination", Model.Paging)
                    </div>
                }
            }
        </div>
    </div>
</div>
