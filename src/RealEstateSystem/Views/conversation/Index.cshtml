@model List<RealEstateSystem.Models.ViewModels.ConversationListItem>
@using RealEstateSystem.Helpers
@{
    ViewBag.Title = "Tin nhắn";
    int needReply = Model.Count(c => c.NeedsReply);
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h3 class="mb-0">Tin nhắn</h3>
            <small class="text-muted">
                @Model.Count cuộc trò chuyện
                @if (needReply > 0)
                {
                    <span class="badge bg-danger ms-1">@needReply cần phản hồi</span>
                }
            </small>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="display-4 text-muted"><i class="bi bi-chat-square-text"></i></div>
                <h5 class="mt-3">Chưa có cuộc trò chuyện nào</h5>
                <p class="text-muted mb-4">Khi có người liên hệ về tin đăng của bạn, hoặc bạn gửi yêu cầu cho môi giới, cuộc trò chuyện sẽ hiện ở đây.</p>
                <a class="btn btn-brand" href="@Url.Action("Index", "Property")">Xem danh sách bất động sản</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="list-group list-group-flush">
                @foreach (var c in Model)
                {
                    <a class="list-group-item list-group-item-action py-3 @(c.NeedsReply ? "bg-warning-subtle" : "")"
                       href="@Url.Action("Details", "Conversation", new { id = c.ConversationId })">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="min-w-0">
                                <div class="fw-semibold">
                                    <i class="bi bi-house-door text-brand"></i> @c.PropertyTitle
                                </div>
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-person"></i> @c.OtherUserName
                                </div>
                                <div class="text-truncate text-muted" style="max-width:640px">@c.LastMessage</div>
                            </div>
                            <div class="text-end flex-shrink-0">
                                <div class="small text-muted mb-1">@c.LastMessageAt.TimeAgo()</div>
                                <span class="badge @ViewHelper.ConversationStatusBadge(c.Status)">@ViewHelper.ConversationStatusText(c.Status)</span>
                                @if (c.NeedsReply)
                                {
                                    <div class="small text-danger fw-semibold mt-1">Cần phản hồi</div>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>
