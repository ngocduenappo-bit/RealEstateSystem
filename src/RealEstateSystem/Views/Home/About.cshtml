@{
    ViewBag.Title = "Giới thiệu";
}

<div class="container py-5">
    <div class="page-head">
        <span class="eyebrow">Về chúng tôi</span>
        <h1>Giới thiệu ESTORA</h1>
        <p>Nền tảng đăng tin và tìm kiếm bất động sản mua bán, cho thuê, kết nối môi giới với người cần tìm nhà.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="info-card">
                <div class="info-icon"><i class="bi bi-search"></i></div>
                <div><h3>Tìm kiếm dễ dàng</h3><p>Lọc theo loại hình, khu vực, mức giá, diện tích và số phòng ngủ.</p></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-card">
                <div class="info-icon"><i class="bi bi-house-door"></i></div>
                <div><h3>Đăng tin nhanh chóng</h3><p>Môi giới và chủ nhà đăng tin kèm hình ảnh, quản lý tin của mình dễ dàng.</p></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-card">
                <div class="info-icon"><i class="bi bi-chat-dots"></i></div>
                <div><h3>Liên hệ trực tiếp</h3><p>Gửi yêu cầu và trao đổi với môi giới ngay trên từng tin đăng.</p></div>
            </div>
        </div>
    </div>
</div>
