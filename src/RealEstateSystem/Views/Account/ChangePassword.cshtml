@model RealEstateSystem.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Đổi mật khẩu";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">

            <ul class="nav nav-pills mb-3 gap-1">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Profile", "Account")"><i class="bi bi-person"></i> Hồ sơ cá nhân</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" style="background:var(--navy)" href="@Url.Action("ChangePassword", "Account")"><i class="bi bi-key"></i> Đổi mật khẩu</a>
                </li>
            </ul>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-brand fw-bold"><i class="bi bi-shield-lock"></i> Đổi mật khẩu</div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("ChangePassword", "Account", new { area = "" }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CurrentPassword, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", autocomplete = "current-password" })
                            @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                            <div class="form-text">Tối thiểu 6 ký tự và phải khác mật khẩu hiện tại.</div>
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.ConfirmNewPassword, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "form-control", autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "text-danger small" })
                        </div>

                        <button type="submit" class="btn btn-brand"><i class="bi bi-check-lg"></i> Đổi mật khẩu</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
