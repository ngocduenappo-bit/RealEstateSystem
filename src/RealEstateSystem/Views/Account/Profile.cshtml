@model RealEstateSystem.Models.ProfileViewModel
@{
    ViewBag.Title = "Hồ sơ cá nhân";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">

            <ul class="nav nav-pills mb-3 gap-1">
                <li class="nav-item">
                    <a class="nav-link active" style="background:var(--navy)" href="@Url.Action("Profile", "Account")"><i class="bi bi-person"></i> Hồ sơ cá nhân</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ChangePassword", "Account")"><i class="bi bi-key"></i> Đổi mật khẩu</a>
                </li>
            </ul>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-brand fw-bold"><i class="bi bi-person-vcard"></i> Thông tin tài khoản</div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("Profile", "Account", new { area = "" }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Email đăng nhập</label>
                            <input type="text" class="form-control" value="@Model.Email" disabled />
                            <div class="form-text">Email là tên đăng nhập nên không thể thay đổi.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-block">Vai trò</label>
                            @if (Model.Role == "admin")
                            {
                                <span class="badge" style="background:var(--navy)">Quản trị viên</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">Người dùng</span>
                            }
                            <span class="small text-muted ms-2">Tham gia từ @Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", maxlength = 150 })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", maxlength = 10, inputmode = "numeric" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                        </div>

                        <button type="submit" class="btn btn-brand"><i class="bi bi-check-lg"></i> Lưu thay đổi</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
