@{
    ViewBag.Title = "Không có quyền truy cập";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm mx-auto" style="max-width:560px">
        <div class="card-body text-center py-5">
            <div class="display-3 text-danger"><i class="bi bi-shield-lock"></i></div>
            <h4 class="mt-3">Bạn không có quyền truy cập trang này</h4>
            <p class="text-muted mb-4">Chức năng này chỉ dành cho tài khoản có quyền phù hợp (quản trị viên hoặc môi giới). Nếu bạn cho rằng đây là nhầm lẫn, hãy đăng nhập bằng tài khoản khác.</p>
            <div class="d-flex justify-content-center gap-2">
                <a class="btn btn-brand" href="@Url.Action("Index", "Home")"><i class="bi bi-house"></i> Về trang chủ</a>
                <a class="btn btn-outline-brand" href="@Url.Action("Login", "Account")"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập tài khoản khác</a>
            </div>
        </div>
    </div>
</div>
